generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NotificationLog {
  id         String   @id @default(uuid())
  type       String
  payload    Json
  status     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
