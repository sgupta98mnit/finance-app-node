generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Transfer {
  id            String         @id @default(uuid())
  fromAccountId String
  toAccountId   String
  amount        Decimal
  currency      String
  status        TransferStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([fromAccountId])
  @@index([toAccountId])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  aggregateId String
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  sentAt      DateTime?

  @@index([status])
}
